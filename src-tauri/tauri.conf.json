{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gloss",
  "version": "0.1.1",
  "identifier": "com.gloss.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "gloss",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4OTg3QTNGQjM2NkJDMUYKUldRZnZHYXpQM3FZcUZZa3d5Uk5XNWRNTE83bC83MHE4MmVLOS9hVDBUME1XZitPY0IwalVKdDQK",
      "endpoints": [
        "https://github.com/kdlegum/Gloss/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
